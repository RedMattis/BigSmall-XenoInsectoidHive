<Defs>
  <ScenarioDef ParentName="ScenarioBase">
    <defName>BS_XenoInsectoidHiveStart_Mutant</defName>
    <label>Xeno Mutant Queen Start</label>
    <description>A mutant xeno queen start which will automatically produce new bugs. Suitable for players who want to run a hive without reliance on multiple queens and consorts.\n\nThis start will replace many wanderers with xeno hive xenotypes, and make non-human space-refugees of all kinds more common.</description>
    <scenario>
      <summary>A mutant xeno queen start which will automatically produce new bugs. Suitable for players who want to run a hive without reliance on multiple queens and consorts.\n\nThis start will replace many wanderers with xeno hive xenotypes, and make non-human space-refugees of all kinds more common.</summary>
      <playerFaction>
        <def>PlayerFaction</def>
        <factionDef>BS_XenoInsectoidHiveStart</factionDef>
      </playerFaction>
      <surfaceLayer>
        <def>SurfaceLayerFixed</def>
        <tag>Surface</tag>
        <layer>Surface</layer>
        <settingsDef>Surface</settingsDef>
        <hide>true</hide>
        <connections>
          <Orbit MayRequire="Ludeon.RimWorld.Odyssey">
            <zoomMode>ZoomOut</zoomMode>
          </Orbit>
        </connections>
      </surfaceLayer>
      <parts>
        <li Class="ScenPart_GameStartDialog">
          <def>GameStartDialog</def>
          <text>A mutant xeno queen and a few followers attempt to establish a new hive.</text>
          <closeSound>GameStartSting</closeSound>
        </li>
        <li Class="ScenPart_ConfigPage_ConfigureStartingPawns_Xenotypes">
          <def>ConfigurePawnsXenotypes</def>
          <pawnChoiceCount>8</pawnChoiceCount>
          <xenotypeCounts>
            <li>
              <count>1</count>
              <requiredAtStart>true</requiredAtStart>
              <xenotype>BS_MutantXenoQueen</xenotype>
              <allowedDevelopmentalStages>Adult</allowedDevelopmentalStages>
            </li>
            <li>
              <count>2</count>
              <requiredAtStart>true</requiredAtStart>
              <xenotype>BS_XenoWorker</xenotype>
              <allowedDevelopmentalStages>Adult, Child</allowedDevelopmentalStages>
            </li>
            <li>
              <count>1</count>
              <requiredAtStart>true</requiredAtStart>
              <xenotype>BS_XenoEmissary</xenotype>
              <allowedDevelopmentalStages>Adult</allowedDevelopmentalStages>
            </li>
          </xenotypeCounts>
        </li>
        <li Class="ScenPart_PlayerPawnsArriveMethod">
          <def>PlayerPawnsArriveMethod</def>
          <method>Standing</method>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Pemmican</thingDef>
          <count>3000</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>MedicineHerbal</thingDef>
          <count>20</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>WoodLog</thingDef>
          <count>400</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Steel</thingDef>
          <count>200</count>
        </li>
        <li Class="ScenPart_StartingResearch">
          <def>StartingResearch</def>
          <project>Smithing</project>
        </li>
        <li Class="ScenPart_StartingResearch">
          <def>StartingResearch</def>
          <project>Pemmican</project>
        </li>
      </parts>
    </scenario>
  </ScenarioDef>
</Defs>